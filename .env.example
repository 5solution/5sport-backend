NODE_ENV=development
NETWORK=testnet
PORT=3000

# PostgreSQL
POSTGRES_URL=

# Redis
REDIS_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# VNPay Payment
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET_KEY=your_vnpay_secret_key

# PAYX Payment
PAYX_MERCHANT_CODE=your_payx_merchant_code
PAYX_SECRET_KEY=your_payx_secret_key
PAYX_API_URL=https://payment-gateway-sandbox.payx.com.vn

# SePay Payment Gateway
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=your_sepay_merchant_id
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key
APP_PUBLIC_BASE_URL=https://your-domain.com

# Mailchimp Transactional (Mandrill)
MAILCHIMP_API_KEY=your_mailchimp_api_key
